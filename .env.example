# Copy this file to .env (which is gitignored) and fill in a real value.
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Optional - defaults to poms-admin if unset.
# ADMIN_GROUP=poms-admin

# Optional - Google AdSense. Leave all blank to run ad-free (the default);
# the ad banners on the dashboard simply don't render if these are unset.
# Get these from https://www.adsense.com after your site is approved.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_AD_SLOT_TOP=
# NEXT_PUBLIC_AD_SLOT_LEFT=
# NEXT_PUBLIC_AD_SLOT_RIGHT=
